# Copy this file to .env and fill in your own values.
# Never commit a real .env file or paste a live key into source code.

# Required: use a long random value, for example from `python -c "import secrets; print(secrets.token_urlsafe(48))"`
QUESTSAGE_SECRET_KEY=replace-with-a-random-64-byte-secret

# Optional: the local OmniRoute gateway
OMNIROUTE_URL=http://127.0.0.1:20129/v1
OMNIROUTE_API_KEY=replace-with-your-own-gateway-key
OMNIROUTE_MODEL=infron/deepseek/deepseek-v4.1-flash
